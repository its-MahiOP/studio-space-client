# Required — MongoDB connection string (BetterAuth user store + studio data)
MONGO_URI=

# Required — the Express data API this app proxies /api/backend/* to.
# Local: http://localhost:5000   Production: https://<your-api>.vercel.app
SERVER_BASE_URL=http://localhost:5000

# Required — BetterAuth session secret (npx @better-auth/cli secret)
BETTER_AUTH_SECRET=
# Public URL of THIS app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Optional — Google OAuth. Leave blank to use email/password sign-in only.
# Redirect URI to register: https://<your-app>.vercel.app/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Optional — image uploads from the studio form (https://api.imgbb.com)
NEXT_PUBLIC_IMGBB_API_KEY=
